# ==============================================================================
# LURKER v2.0 // ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Discord Gateway Configuration
# ------------------------------------------------------------------------------
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id
OWNER_ID=your_discord_user_id
COMMAND_PREFIX=!

# Enable Presence Intent in Discord Developer Portal if you want online-status Gremlin roasts
ENABLE_PRESENCE_INTENT=false

# ------------------------------------------------------------------------------
# 2. Multi-Model AI Routing & Providers
# ------------------------------------------------------------------------------
# Provider failover priority: groq, gemini, openai
AI_PROVIDER_ORDER=groq,gemini,openai

# Primary Provider: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=12000
GROQ_MAX_TOKENS=90
GROQ_TEMPERATURE=0.95
GROQ_MAX_RETRIES=2

# Fallback Provider: Google Gemini (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fallback Provider: OpenAI / Ollama Local LLM (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:11434/v1 # For local Ollama

# ------------------------------------------------------------------------------
# 3. Database & Web Dashboard
# ------------------------------------------------------------------------------
DATABASE_PATH=./data/bot.sqlite
PORT=8080
LOG_LEVEL=info
DASHBOARD_TOKEN=

# ------------------------------------------------------------------------------
# 4. Ambient Conversation Intelligence & Cooldowns
# ------------------------------------------------------------------------------
AI_ENABLED=true
REPLY_CHANCE=0.15
KEYWORD_REPLY_CHANCE=0.35
CHANNEL_COOLDOWN_SECONDS=60
USER_COOLDOWN_SECONDS=25
MAX_CONTEXT_MESSAGES=15
DECISION_SCORE_THRESHOLD=35
ACTIVE_CONVERSATION_USERS=3
FOMO_MESSAGE_COUNT=60
REPLY_TIMEOUT_MS=10000
MAX_REPLY_LENGTH=260

# ------------------------------------------------------------------------------
# 5. Human Mimicry & Typing Engine
# ------------------------------------------------------------------------------
ENABLE_MULTI_BUBBLE=true
MULTI_BUBBLE_CHANCE=0.22
BURST_DELAY_MS=900
TYPING_MIN_MS=1800
TYPING_MAX_MS=4500
TYPING_CHARS_PER_SECOND=8
REACTION_CHANCE=0.05
EMOJI_ONLY_CHANCE=0.08
IMPERFECTION_CHANCE=0.08
DUPLICATE_LOOKBACK_MESSAGES=12
DUPLICATE_SIMILARITY_THRESHOLD=0.72

# ------------------------------------------------------------------------------
# 6. Personality & Mood System
# ------------------------------------------------------------------------------
PERSONALITY_MODE=mood # 'mood' (time-scheduled) or 'roulette' (weighted random)

# ------------------------------------------------------------------------------
# 7. Hot Takes Debate Arena & Interactive Polls
# ------------------------------------------------------------------------------
ENABLE_HOT_TAKES=true
ENABLE_HOT_TAKE_POLLS=true
HOT_TAKE_PROBABILITY=45
ARGUMENT_REPLY_CHANCE=65
ARGUMENT_DURATION_MINUTES=15
MINIMUM_MESSAGES_BETWEEN_HOT_TAKES=35
MINIMUM_MINUTES_BETWEEN_HOT_TAKES=180
HOT_TAKE_ACTIVE_RECENT_MINUTES=8
HOT_TAKE_MINIMUM_RECENT_MESSAGES=6
HOT_TAKE_AGREEMENT_SWITCH_COUNT=2

# ------------------------------------------------------------------------------
# 8. Secret Target Gremlin Rivalry Engine
# ------------------------------------------------------------------------------
ENABLE_TARGET_GREMLIN=true
TARGET_USER_ID=
CHECK_INTERVAL_MINUTES=20
BASE_TRIGGER_CHANCE=0.45
ONLINE_TRIGGER_CHANCE=0.65
RECENT_MESSAGE_TRIGGER_CHANCE=0.90
MENTION_CHANCE=0.25
REPLY_CHANCE_DURING_GREMLIN=0.70
GREMLIN_ARGUMENT_REPLY_CHANCE=0.90
DEFENDER_REPLY_CHANCE=0.25
MAX_DAILY_ROASTS=10
MAX_MENTIONS_PER_DAY=2

# ------------------------------------------------------------------------------
# 9. Channel Reviver Engine
# ------------------------------------------------------------------------------
REVIVER_CRON=*/5 * * * *
REVIVER_MIN_MINUTES=45
REVIVER_MAX_MINUTES=90
REVIVER_MIN_GAP_MINUTES=45
